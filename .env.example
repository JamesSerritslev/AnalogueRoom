# Resend — host event inquiry API (`/api/host-inquiry`)
RESEND_API_KEY=
RESEND_FROM=
# Comma-separated staff inboxes (all receive the same inquiry email)
HOST_INQUIRY_TO_EMAIL=

# Sanity (public)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# Required in Vercel env vars; canonical public origin (no trailing slash).
# Production: https://www.analogueroom.com  (use www — matches sitemap + redirects)
# Locally: leave as http://localhost:3000.
# (NEXT_PUBLIC_VERCEL_URL is a Vercel auto-inject; no need to set it manually.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# One-time seed: `npm run seed:pages`; Editor token from sanity.io/manage (do not commit)
# SANITY_API_TOKEN=
# Visual Editing / Presentation (server-only)
# SANITY_API_READ_TOKEN=
# Mapbox (public)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Local SEO / GBP consistency (public)
# Display phone exactly as on Google Business Profile (e.g. (805) 555-0100)
NEXT_PUBLIC_VENUE_PHONE=
# Optional: short share link only (maps.app.goo.gl / share.google) — no & in the value.
# Full Maps place URLs are hardcoded in lib/venue-location.ts (Vercel truncates & in env).
# NEXT_PUBLIC_GOOGLE_BUSINESS_URL=
# Optional real Place ID only (ChIJ…) — not a URL
# NEXT_PUBLIC_GOOGLE_PLACE_ID=

# Mailchimp: newsletter API
MAILCHIMP_SERVER=
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
