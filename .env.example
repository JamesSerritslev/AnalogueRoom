# Resend — host event inquiry API (`/api/host-inquiry`)
RESEND_API_KEY=
RESEND_FROM=
# Comma-separated staff inboxes (all receive the same inquiry email)
HOST_INQUIRY_TO_EMAIL=

# Sanity (public)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# Required in Vercel env vars; canonical public origin (no trailing slash).
# Production: https://www.analogueroom.com  (use www — matches sitemap + redirects)
# Locally: leave as http://localhost:3000.
# (NEXT_PUBLIC_VERCEL_URL is a Vercel auto-inject; no need to set it manually.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# One-time seed: `npm run seed:pages`; Editor token from sanity.io/manage (do not commit)
# SANITY_API_TOKEN=
# Visual Editing / Presentation (server-only)
# SANITY_API_READ_TOKEN=
# Mapbox (public)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Local SEO / GBP consistency (public)
# Optional override — defaults to (805) 691-9093 in lib/venue-location.ts
# NEXT_PUBLIC_VENUE_PHONE=(805) 691-9093
# Optional: short share link only (maps.app.goo.gl / share.google) — no & in the value.
# Full Maps place URLs are hardcoded in lib/venue-location.ts (Vercel truncates & in env).
# NEXT_PUBLIC_GOOGLE_BUSINESS_URL=
# Place ID (ChIJ…) — preferred for live reviews; also accepted as NEXT_PUBLIC_GOOGLE_PLACE_ID
# Find it: https://developers.google.com/maps/documentation/javascript/examples/places-placeid-finder
# GOOGLE_PLACE_ID=
# NEXT_PUBLIC_GOOGLE_PLACE_ID=

# Google Places API (New) — server-only key for live homepage reviews
# Enable “Places API (New)” in Google Cloud.
# Application restriction: None (or IP addresses). Do NOT use HTTP referrers —
# Next.js server fetches have no browser referrer and will get 403.
# API restriction: Places API (New) is enough.
# GOOGLE_PLACES_API_KEY=

# Mailchimp: newsletter API
MAILCHIMP_SERVER=
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
